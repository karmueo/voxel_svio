# RViz2 配置，用于显示 Voxel-SVIO 估计轨迹、真值轨迹和地图可视化。
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.03
      Name: VIO Path
      Pose Style: None
      Topic: /vio/path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 255
      Enabled: true
      Line Style: Billboards
      Line Width: 0.03
      Name: Groundtruth Path
      Pose Style: None
      Topic: /vio/groundtruth_path
      Unreliable: false
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Stereo Features
      Normalize Range: true
      Queue Size: 2
      Topic: /camera/stereo_feat_image
      Unreliable: false
      Value: true
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: History Map Points
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 3
      Size (m): 0.02
      Style: Points
      Topic: /vio/history_map_points
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Window Map Points
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 4
      Size (m): 0.03
      Style: Points
      Topic: /vio/window_map_points
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.7
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 170; 0
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Name: History Voxels
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 3
      Size (m): 0.05
      Style: Boxes
      Topic: /vio/history_voxels
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 255; 120
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Name: Visit Voxels
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 4
      Size (m): 0.08
      Style: Boxes
      Topic: /vio/visit_voxels
      Unreliable: false
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Target Frame: camera_init
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: true
  Stereo Features:
    collapsed: false
  Views:
    collapsed: true
  Width: 1920
  X: 0
  Y: 0
